    "/simulation/sessions/{sessionId}/report": {
      "get": {
        "tags": [
          "투자 리포트"
        ],
        "summary": "투자 리포트 조회 (비동기 생성, 폴링)",
        "description": "규칙 기반 요약(자산/수익률/거래 수)은 즉시 계산해 반환한다. AI 분석 4개 섹션은 최초 요청 시 백그라운드로 생성이 시작되며, 응답의 `status` 로 진행 상태를 알린다: `GENERATING`(HTTP 202, 분석 미완료·재요청 필요) / `READY`(HTTP 200, 4개 섹션 포함) / `FAILED`(HTTP 202, 다음 요청 시 자동 재시도). FE 는 202 응답을 폴링해야 한다.",
        "operationId": "getReport",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseInvestmentReportResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
